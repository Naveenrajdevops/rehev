# ==============================================================================
# REHABAI PRO - PLATFORM CONFIGURATION
# ==============================================================================

# Frontend API Configuration (for Vercel deployment)
# In development: leave empty to use relative /api path with Vite proxy
# In production on Vercel: leave empty - Vercel automatically routes /api to serverless functions
VITE_API_URL=

# AI LLM Provider Configuration (Optional - Intelligent clinical rule engine active if unset)
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Database Configuration (Defaults to SQLite out-of-the-box, or PostgreSQL)
# For Vercel: SQLite works on ephemeral filesystem
# For persistent storage: Use PostgreSQL with DATABASE_URL
DATABASE_URL=sqlite:///./rehabai.db
# DATABASE_URL=postgresql://rehabai_user:rehabai_secret_password@localhost:5432/rehabai_db

# JWT Authentication Secret (Generate a random string for production)
# IMPORTANT: Change this in production to a secure random value
JWT_SECRET=rehabai-pro-super-secret-key-2026-production

# Server Port (Vercel uses dynamic PORT, but defaults to 8000 for local dev)
PORT=8000
